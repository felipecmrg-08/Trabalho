import java.util.Scanner;

public class Fibonacci {
 
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
 
        System.out.print("Digite o número de termos (N) da sequência de Fibonacci: ");
        int n = scanner.nextInt();
 
        // Validação simples de entrada
        while (n <= 0) {
            System.out.print("Por favor, digite um número inteiro positivo: ");
            n = scanner.nextInt();
        }
 
        System.out.println("\nPrimeiros " + n + " termos da sequência de Fibonacci:");
        exibirFibonacci(n);
 
        scanner.close();
    }
     
    public static void exibirFibonacci(int n) {
        long anterior = 0;
        long atual = 1;
 
        for (int i = 0; i < n; i++) {
            if (i == 0) {
                System.out.print(anterior);
            } else {
                System.out.print(", " + anterior);
            }
 
            long proximo = anterior + atual;
            anterior = atual;
            atual = proximo;
        }
 
        System.out.println();
    }
}